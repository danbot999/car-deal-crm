        "id": "0afd8612-6742-4575-af49-d85bc797f544",
        "name": "Ensure Car Listings Table"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const source = $('Webhook').first().json;\nconst listings = source.body?.items ?? source.items ?? [];\n\nif (!Array.isArray(listings)) {\n  return [];\n}\n\nconst now = new Date().toISOString();\nconst seenInPayload = new Set();\nconst output = [];\n\nfor (const listing of listings) {\n  const title = String(listing?.title ?? '').trim();\n  const price = Number(listing?.price);\n  const url = String(listing?.url ?? '').trim();\n\n  const isValid =\n    title.length > 0 &&\n    Number.isFinite(price) &&\n    price >= 0 &&\n    price <= 7000 &&\n    url.includes('/marketplace/item/') &&\n    !seenInPayload.has(url);\n\n  if (!isValid) {\n    continue;\n  }\n\n  seenInPayload.add(url);\n  output.push({\n    json: {\n      title,\n      price,\n      url,\n      firstSeen: now,\n    },\n  });\n}\n\nreturn output;"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
