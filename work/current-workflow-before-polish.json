[{"updatedAt":"2026-06-08T08:07:51.308Z","createdAt":"2026-06-04T01:37:01.243Z","id":"z08K09PwtzaaDmZN","name":"Auckland Car Listing Monitor","description":"Receives Facebook Marketplace car listings from the Python monitor, validates them, deduplicates by URL, and stores new listings in an n8n Data Table.","active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"e0c77d34-c1ec-410a-9b23-b9340180379b","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"d6b9adc7-e643-465c-adf7-4de658262289","name":"Webhook","webhookId":"e0c77d34-c1ec-410a-9b23-b9340180379b"},{"parameters":{"resource":"table","operation":"create","tableName":"car_listings","columns":{"column":[{"name":"title"},{"name":"price","type":"number"},{"name":"url"},{"name":"firstSeen"}]},"options":{"createIfNotExists":true}},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[272,0],"id":"0afd8612-6742-4575-af49-d85bc797f544","name":"Ensure Car Listings Table"},{"parameters":{"jsCode":"const source = $('Webhook').first().json;\nconst listings = source.body?.items ?? source.items ?? [];\n\nif (!Array.isArray(listings)) {\n  return [];\n}\n\nconst now = new Date().toISOString();\nconst seenInPayload = new Set();\nconst output = [];\n\nfor (const listing of listings) {\n  const title = String(listing?.title ?? '').trim();\n  const price = Number(listing?.price);\n  const url = String(listing?.url ?? '').trim();\n\n  const isValid =\n    title.length > 0 &&\n    Number.isFinite(price) &&\n    price >= 0 &&\n    price <= 7000 &&\n    url.includes('/marketplace/item/') &&\n    !seenInPayload.has(url);\n\n  if (!isValid) {\n    continue;\n  }\n\n  seenInPayload.add(url);\n  output.push({\n    json: {\n      title,\n      price,\n      url,\n      firstSeen: now,\n    },\n  });\n}\n\nreturn output;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[528,0],"id":"d4067688-2b80-4811-9eb5-a6790757395e","name":"Prepare Car Listings"},{"parameters":{"operation":"rowNotExists","dataTableId":{"__rl":true,"mode":"name","value":"car_listings"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"url","keyValue":"={{ $json.url }}"}]}},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[784,0],"id":"c36fe016-d287-47ee-b1a7-269fba43973e","name":"If Listing Is New"},{"parameters":{"dataTableId":{"__rl":true,"mode":"name","value":"car_listings"},"columns":{"mappingMode":"autoMapInputData","value":{},"matchingColumns":[],"schema":[{"id":"title","displayName":"title","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"price","displayName":"price","required":false,"defaultMatch":false,"display":true,"type":"number","readOnly":false,"removed":false},{"id":"url","displayName":"url","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"firstSeen","displayName":"firstSeen","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{}},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1040,0],"id":"05b7f71e-28f3-45da-96fb-430e6cd8f94c","name":"Store New Listing"}],"connections":{"Webhook":{"main":[[{"node":"Ensure Car Listings Table","type":"main","index":0}]]},"Ensure Car Listings Table":{"main":[[{"node":"Prepare Car Listings","type":"main","index":0}]]},"Prepare Car Listings":{"main":[[{"node":"If Listing Is New","type":"main","index":0}]]},"If Listing Is New":{"main":[[{"node":"Store New Listing","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","saveDataErrorExecution":"all","saveDataSuccessExecution":"all"},"staticData":null,"meta":null,"nodeGroups":[],"pinData":{},"versionId":"c6d71cd5-bafe-4958-9e11-afb8a9e98706","activeVersionId":"c6d71cd5-bafe-4958-9e11-afb8a9e98706","versionCounter":7,"triggerCount":1,"tags":[],"shared":[{"updatedAt":"2026-06-04T01:37:01.247Z","createdAt":"2026-06-04T01:37:01.247Z","role":"workflow:owner","workflowId":"z08K09PwtzaaDmZN","projectId":"kUaBoGbk4cBc5gDp","project":{"updatedAt":"2026-06-04T01:36:31.537Z","createdAt":"2026-06-04T01:35:39.735Z","id":"kUaBoGbk4cBc5gDp","name":"Daniel Younan <dcnz.younan@gmail.com>","type":"personal","icon":null,"description":null,"creatorId":"e4c52575-6693-4a00-9e61-2680607e057c"}}],"versionMetadata":{"name":"Version 1","description":"Python script, workflow automation"}}]